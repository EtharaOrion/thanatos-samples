-	if err != nil {
-		return
-	}
-
-	hasher := sha256.New()
-	_, err = hasher.Write([]byte(path + "\n"))
-	if err != nil {
-		return
-	}
-	if _, err = io.Copy(hasher, fd); err != nil {
-		return
-	}
-
-	return fmt.Sprintf("%x", hasher.Sum(nil)), nil
