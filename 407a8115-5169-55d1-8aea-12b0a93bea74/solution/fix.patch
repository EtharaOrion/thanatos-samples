diff --git a/packages/twenty-front/src/modules/settings/profile/devices/utils/__tests__/parseUserAgentDescription.test.ts b/packages/twenty-front/src/modules/settings/profile/devices/utils/__tests__/parseUserAgentDescription.test.ts
