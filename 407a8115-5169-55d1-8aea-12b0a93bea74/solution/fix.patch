+
+  @Field(() => String, { nullable: true })
+  ipAddress: string | null;
+
+  @Field(() => Date)
+  createdAt: Date;
+
+  @Field(() => Date)
+  lastActiveAt: Date;
+
+  @Field(() => Date)
